# Copy to backend/.env (gitignored). Read only via app/config/settings.py.
# This file holds non-secret settings only — every API key and token lives
# in the local secret store (data/proprisk_secrets.sqlite3), set from the
# Settings screen or `scripts/keys.sh`, never here.
DATABASE_URL=postgresql+psycopg://proprisk@127.0.0.1:55432/proprisk
PROPRISK_PORT=8765

# Optional: forward error-sink events to an external receiver.
# ERROR_SINK_URL=
